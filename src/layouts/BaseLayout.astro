---
import PaletteSwitcher from "../components/PaletteSwitcher.astro";
import FlagFR from "../components/FlagFR.astro";
import NewsletterPopup from "../components/NewsletterPopup.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { SITE } from "../lib/site";
import { organizationSchema } from "../lib/schema";
import { UI, HOME_SWITCHER, type Locale, type SwitcherLinks } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  ogType?: "website" | "article";
  lang?: Locale;
  switcherLinks?: SwitcherLinks;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  jsonLd = [],
  ogImage = "/og-image.png",
  ogType = "website",
  lang = "fr",
  switcherLinks = HOME_SWITCHER,
  noindex = false,
} = Astro.props;

const t = UI[lang];
const canonicalUrl = new URL(path, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();
const schemas = [organizationSchema(), ...jsonLd];
const ogLocale = { fr: "fr_FR", en: "en_US", de: "de_DE" }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr" href={new URL(switcherLinks.fr, SITE.url).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(switcherLinks.en, SITE.url).toString()} />
    <link rel="alternate" hreflang="de" href={new URL(switcherLinks.de, SITE.url).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(switcherLinks.fr, SITE.url).toString()} />

    <!--
      Defense in depth: this <meta> CSP applies even if the real HTTP header
      in public/_headers is ever stripped by a CDN/proxy in front of the
      site. frame-ancestors and frame-busting headers are HTTP-only and
      can't be set via <meta> — that's handled in public/_headers instead,
      now that the site runs on Netlify (which supports custom response
      headers), not GitHub Pages.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; media-src 'self'; connect-src 'self' https://www.facebook.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://formspree.io; frame-src https://www.facebook.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
    />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0f1e33" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Actualités`} href="/actualites/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <div class="grain-overlay" aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-gold focus:px-4 focus:py-2 focus:text-night"
    >
      {t.skipToContent}
    </a>
    <div class="sticky top-0 z-40">
      <div class="border-b border-ink-line bg-sand text-[11px] text-paper-dim sm:text-xs">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6">
          <span class="hidden items-center gap-1.5 lg:flex"><FlagFR /> {t.stockSav}</span>
          <span class="mx-auto lg:mx-0">
            <span data-promo>
              <span class="font-semibold text-promo">{t.promoBar}</span>
              · {t.promoEndsIn} <span data-countdown-inline class="font-mono">…</span>
            </span>
            <span data-promo-fallback hidden>{t.freeShipping}</span>
          </span>
          <span class="hidden lg:inline">{t.freeShipping}</span>
        </div>
      </div>
      <Header lang={lang} switcherLinks={switcherLinks} />
    </div>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
    <NewsletterPopup lang={lang} />
    {(import.meta.env.DEV || import.meta.env.PUBLIC_PALETTE_SWITCHER === "1") && <PaletteSwitcher />}
    <script>
      import { initRevealObserver } from "../scripts/reveal";
      import { initMobileMenu } from "../scripts/mobile-menu";
      import { initCartUI } from "../scripts/cart-ui";
      import { initHeroReveal } from "../scripts/hero-reveal";
      import { initProductGallery } from "../scripts/product-gallery";
      import { initScrollTracking } from "../scripts/scroll-tracking";
      import { initPromoCountdown } from "../scripts/promo-countdown";

      // astro:page-load fires on the very first load AND after every
      // client-side transition, so page-specific DOM (headlines, buttons,
      // reveal targets, header) gets re-wired each time the router swaps content.
      // Lancé aussi immédiatement : si le module arrive après le premier
      // astro:page-load, le compte à rebours ne resterait pas vide.
      initPromoCountdown();
      document.addEventListener("astro:page-load", () => {
        initPromoCountdown();
        initRevealObserver();
        initMobileMenu();
        initCartUI();
        initHeroReveal();
        initProductGallery();
        initScrollTracking();
      });
    </script>
  </body>
</html>
