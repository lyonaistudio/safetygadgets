---
import type { Locale } from "../lib/i18n";

// Guide carte SIM du Tracker OBD : la SIM n'est pas fournie, c'est le
// principal frein à l'achat, donc on explique quoi prendre en 3 étapes.
// Exemple d'offre vérifié en septembre 2026 (forfait Free 2 € : appels/SMS
// illimités + 1 Go, sans engagement) — à revérifier si l'offre change.
interface Props {
  lang?: Locale;
}
const { lang = "fr" } = Astro.props;

const TEXT: Record<Locale, { eyebrow: string; title: string; intro: string; steps: [string, string][]; example: string; note: string }> = {
  fr: {
    eyebrow: "Carte SIM",
    title: "Quelle carte SIM choisir ?",
    intro: "Le tracker envoie sa position par le réseau 4G : il lui faut une carte SIM avec un peu de data (non fournie). Pas besoin d'un gros forfait.",
    steps: [
      ["Un forfait 4G avec data", "N'importe quel opérateur convient. Un tracker consomme peu de données : un petit forfait suffit largement."],
      ["Désactivez le code PIN", "Insérez d'abord la SIM dans un téléphone et retirez le code PIN dans les réglages : le tracker ne peut pas le saisir."],
      ["Insérez et branchez", "Glissez la SIM dans le tracker, branchez-le sur la prise OBD et suivez votre véhicule depuis l'application."],
    ],
    example: "Exemple : le forfait Free à 2 €/mois (appels et SMS illimités, 1 Go de data, sans engagement — gratuit pour les abonnés Freebox) convient très bien.",
    note: "Offre donnée à titre d'exemple, sans partenariat, susceptible d'évoluer.",
  },
  en: {
    eyebrow: "SIM card",
    title: "Which SIM card should I use?",
    intro: "The tracker sends its position over the 4G network, so it needs a SIM card with a little data (not included). No need for a big plan.",
    steps: [
      ["A 4G plan with data", "Any carrier works. A tracker uses very little data: a small plan is plenty."],
      ["Disable the PIN code", "First put the SIM in a phone and turn off the PIN code in the settings: the tracker can't enter it."],
      ["Insert and plug in", "Slide the SIM into the tracker, plug it into the OBD port and follow your vehicle from the app."],
    ],
    example: "In France, for example, Free's €2/month plan (unlimited calls and texts, 1 GB of data, no commitment) works perfectly.",
    note: "Given as an example only, no partnership, subject to change.",
  },
  de: {
    eyebrow: "SIM-Karte",
    title: "Welche SIM-Karte brauche ich?",
    intro: "Der Tracker sendet seine Position über das 4G-Netz und benötigt daher eine SIM-Karte mit etwas Datenvolumen (nicht enthalten). Ein großer Tarif ist nicht nötig.",
    steps: [
      ["Ein 4G-Tarif mit Daten", "Jeder Anbieter funktioniert. Ein Tracker verbraucht sehr wenig Daten: ein kleiner Tarif reicht völlig."],
      ["PIN-Code deaktivieren", "Legen Sie die SIM zuerst in ein Handy ein und deaktivieren Sie den PIN-Code: Der Tracker kann ihn nicht eingeben."],
      ["Einlegen und einstecken", "SIM in den Tracker einlegen, in die OBD-Buchse stecken und das Fahrzeug in der App verfolgen."],
    ],
    example: "In Frankreich eignet sich zum Beispiel der Free-Tarif für 2 €/Monat (unbegrenzt telefonieren und SMS, 1 GB Daten, ohne Vertragsbindung).",
    note: "Nur als Beispiel, keine Partnerschaft, Änderungen vorbehalten.",
  },
};
const t = TEXT[lang];
---

<section id="carte-sim" class="mx-auto max-w-6xl scroll-mt-32 px-4 pt-14 sm:px-6">
  <div class="hero-banner rounded-2xl p-6 sm:p-10">
    <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-accent">{t.eyebrow}</p>
    <h2 class="mt-2 font-display text-2xl font-semibold text-paper sm:text-3xl">{t.title}</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-paper-dim sm:text-base">{t.intro}</p>
    <ol class="mt-6 grid gap-3 sm:grid-cols-3">
      {t.steps.map(([title, body], i) => (
        <li class="rounded-xl bg-white/85 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-night text-sm font-semibold text-white">{i + 1}</span>
          <p class="mt-3 text-sm font-semibold text-paper">{title}</p>
          <p class="mt-1 text-sm leading-relaxed text-paper-dim">{body}</p>
        </li>
      ))}
    </ol>
    <p class="mt-5 text-sm text-paper">{t.example}</p>
    <p class="mt-1 text-[11px] text-mist">{t.note}</p>
  </div>
</section>
