---
import type { Locale } from "../lib/i18n";

interface Props {
  lang?: Locale;
}

const { lang = "fr" } = Astro.props;

// Identifiants de mesure, fournis au build par variables d'environnement
// (Netlify > Site configuration > Environment variables) :
//   PUBLIC_GA_ID          ex. G-XXXXXXXXXX (Google Analytics 4)
//   PUBLIC_META_PIXEL_ID  ex. 1234567890 (pixel Meta : Facebook/Instagram)
// Sans aucun identifiant, rien n'est chargé et le bandeau ne s'affiche pas.
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_ID ?? "";
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID ?? "";
const enabled = Boolean(GA_MEASUREMENT_ID || META_PIXEL_ID);

const TEXT: Record<Locale, { body: string; link: string; refuse: string; accept: string }> = {
  fr: {
    body: "Avec votre accord, nous utilisons des cookies de mesure d'audience et de publicité (Google, Meta) pour savoir ce qui vous intéresse et améliorer nos annonces. Voir notre",
    link: "politique de confidentialité",
    refuse: "Refuser",
    accept: "Accepter",
  },
  en: {
    body: "With your consent, we use audience measurement and advertising cookies (Google, Meta) to understand what interests you and improve our ads. See our",
    link: "privacy policy",
    refuse: "Decline",
    accept: "Accept",
  },
  de: {
    body: "Mit Ihrer Zustimmung verwenden wir Cookies zur Reichweitenmessung und Werbung (Google, Meta), um Ihre Interessen zu verstehen und unsere Anzeigen zu verbessern. Siehe unsere",
    link: "Datenschutzerklärung",
    refuse: "Ablehnen",
    accept: "Akzeptieren",
  },
};
const t = TEXT[lang];
---

{enabled && <div
  id="cookie-consent"
  data-ga-id={GA_MEASUREMENT_ID}
  data-meta-pixel-id={META_PIXEL_ID}
  hidden
  class="fixed inset-x-0 bottom-0 z-[100] border-t border-ink-line bg-white/97 px-6 py-5 shadow-[0_-20px_40px_-20px_rgba(60,45,30,0.25)] backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-relaxed text-paper-dim">
      {t.body}{" "}
      <a href="/mentions-legales/" class="text-accent underline underline-offset-2 hover:text-accent">{t.link}</a>.
    </p>
    <div class="flex shrink-0 gap-3 text-sm">
      <button
        type="button"
        id="cookie-refuse"
        class="rounded-lg border border-ink-line px-4 py-2 text-paper transition-colors hover:border-accent hover:text-accent"
      >
        {t.refuse}
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="rounded-lg bg-night px-4 py-2 font-semibold text-white transition-colors hover:bg-night-soft"
      >
        {t.accept}
      </button>
    </div>
  </div>
</div>}

<script>
  import { initCookieConsent } from "../scripts/cookie-consent";

  document.addEventListener("astro:page-load", () => {
    const banner = document.getElementById("cookie-consent");
    if (banner) initCookieConsent(banner.dataset.gaId ?? "", banner.dataset.metaPixelId ?? "");
  });
</script>
