---
import type { Product } from "../data/products";
import type { Locale } from "../lib/i18n";
import { formatPriceTTC } from "../data/products";
import { PROMO } from "../lib/promo";

// Carte produit horizontale (accueil, liste des produits). En français le
// bouton ajoute au panier ; en anglais/allemand il mène à la fiche.
interface Props {
  product: Product;
  lang?: Locale;
}
const { product: p, lang = "fr" } = Astro.props;
const base = lang === "fr" ? "" : `/${lang}`;
const href = `${base}/traceurs-gps/${p.slug}/`;
const promoPct = `−${Math.round(PROMO.rate * 100)} %`;
const label = { fr: "Ajouter au panier", en: "View product", de: "Produkt ansehen" }[lang];
---

<article class="group relative flex gap-3 rounded-2xl border border-ink-line bg-white p-3 shadow-sm transition-shadow hover:shadow-lg sm:gap-6 sm:p-6">
  {p.originalPrice && <span data-promo class="absolute left-3 top-3 z-10 rounded bg-promo px-1.5 py-0.5 text-[10px] font-bold text-white sm:left-4 sm:top-4 sm:px-2 sm:text-xs">{promoPct}</span>}
  <a href={href} class="flex w-24 shrink-0 items-center justify-center rounded-xl bg-ink-soft sm:w-44">
    <img src={p.image} alt={p.name} width="160" height="160" class="h-20 w-20 object-contain transition-transform group-hover:scale-105 sm:h-40 sm:w-36" />
  </a>
  <div class="flex flex-1 flex-col">
    <span class="text-[10px] uppercase tracking-[0.15em] text-accent-dim sm:text-[11px]">{p.category}</span>
    <h3 class="mt-0.5 text-sm font-semibold leading-snug text-paper sm:mt-1 sm:text-lg"><a href={href}>{p.name}</a></h3>
    <p class="mt-1 line-clamp-1 text-xs text-paper-dim sm:line-clamp-2 sm:text-sm">{p.tagline}</p>
    <p class="mt-auto flex flex-wrap items-baseline gap-x-2 pt-2 sm:pt-3">
      <span data-price-regular={p.originalPrice && formatPriceTTC(p.originalPrice)} class="whitespace-nowrap text-base font-bold text-paper sm:text-xl">{formatPriceTTC(p.price)}</span>
      {p.originalPrice && <span data-promo class="whitespace-nowrap text-xs text-paper-dim line-through sm:text-sm">{formatPriceTTC(p.originalPrice)}</span>}
    </p>
    {lang === "fr" ? (
      <button type="button" data-add-to-cart={p.slug} class="mt-2 w-fit rounded-lg bg-night px-3.5 py-2 text-xs sm:mt-3 sm:px-4 font-semibold text-white transition-colors hover:bg-gold hover:text-night">{label}</button>
    ) : (
      <a href={href} class="mt-2 w-fit rounded-lg bg-night px-3.5 py-2 text-xs sm:mt-3 sm:px-4 font-semibold text-white transition-colors hover:bg-gold hover:text-night">{label}</a>
    )}
  </div>
</article>
