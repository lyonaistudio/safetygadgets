---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "./Breadcrumb.astro";
import ProductCard from "./ProductCard.astro";
import FAQAccordion from "./FAQAccordion.astro";
import CTASection from "./CTASection.astro";
import { PRODUCTS } from "../data/products";
import { faqSchema } from "../lib/schema";
import type { Audience } from "../data/audiences";

interface Props {
  audience: Audience;
}
const { audience: a } = Astro.props;
const products = a.products.map((slug) => PRODUCTS.find((p) => p.slug === slug)).filter((p) => p && !p.comingSoon);
---

<BaseLayout title={a.metaTitle} description={a.metaDescription} path={a.path} jsonLd={[faqSchema(a.faq)]}>
  <Breadcrumb items={[{ name: a.navLabel, url: a.path }]} />

  <section class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 sm:pt-5">
    <div class="hero-banner grid items-center gap-4 overflow-hidden rounded-2xl px-5 py-6 sm:gap-8 sm:px-12 sm:py-12 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-accent">{a.eyebrow}</p>
        <h1 class="mt-2 font-display text-2xl font-semibold leading-tight text-paper sm:mt-3 sm:text-5xl">{a.title}</h1>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-paper-dim sm:mt-4 sm:text-lg">{a.intro}</p>
        <a href="#produits" class="mt-4 hidden sm:mt-6 sm:inline-flex rounded-lg bg-night px-5 py-3 text-sm font-semibold text-white hover:bg-night-soft">Voir {products.length > 1 ? "les produits" : "le produit"}</a>
      </div>
      <div class="relative flex min-h-32 items-end justify-center gap-8 sm:min-h-56">
        <span class="halo" aria-hidden="true"></span>
        {products.map((p) => (
          <img src={p!.image} alt="" width="160" height="200" class="product-shot relative h-28 w-auto object-contain sm:h-56" />
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pt-3 sm:px-6 sm:pt-10">
    <div class="grid gap-2 sm:grid-cols-3 sm:gap-4">
      {a.benefits.map((b) => (
        <div class="flex gap-3 rounded-xl bg-ink-soft p-3 sm:block sm:rounded-2xl sm:p-6">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-accent" aria-hidden="true"><path d="m5 12 4 4 10-10" /></svg>
          <span class="block">
            <h2 class="text-sm font-semibold text-paper sm:mt-3 sm:text-base">{b.title}</h2>
            <p class="mt-0.5 text-xs leading-relaxed text-paper-dim sm:mt-1 sm:text-sm">{b.body}</p>
          </span>
        </div>
      ))}
    </div>
  </section>

  <section id="produits" class="mx-auto max-w-7xl scroll-mt-32 px-4 pt-8 sm:px-6 sm:pt-14">
    <p class="hidden text-[11px] font-medium uppercase tracking-[0.3em] text-accent sm:block">Notre recommandation</p>
    <h2 class="font-display text-lg font-semibold text-paper sm:mt-2 sm:text-3xl">{products.length > 1 ? "Les produits adaptés" : "Le produit adapté"}</h2>
    <div class="mt-3 grid gap-3 sm:mt-6 sm:grid-cols-2 sm:gap-5">
      {products.map((p) => <ProductCard product={p!} />)}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 sm:pt-14">
    <p class="hidden text-[11px] font-medium uppercase tracking-[0.3em] text-accent sm:block">Au quotidien</p>
    <h2 class="font-display text-lg font-semibold text-paper sm:mt-2 sm:text-3xl">Dans quelles situations ?</h2>
    <div class="scroll-row -mx-4 mt-3 flex snap-x scroll-px-4 gap-3 overflow-x-auto px-4 sm:mx-0 sm:mt-6 sm:grid sm:grid-cols-2 sm:gap-4 sm:overflow-visible sm:px-0 lg:grid-cols-4">
      {a.scenarios.map((s) => (
        <div class="w-60 shrink-0 snap-start rounded-2xl border border-ink-line bg-white p-4 sm:w-auto sm:p-6">
          <h3 class="text-sm font-semibold text-paper sm:text-base">{s.title}</h3>
          <p class="mt-1 text-xs leading-relaxed text-paper-dim sm:mt-2 sm:text-sm">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-16">
    <h2 class="font-display text-lg font-semibold text-paper sm:text-3xl">Questions fréquentes</h2>
    <div class="mt-3 sm:mt-6"><FAQAccordion items={a.faq} /></div>
  </section>

  <CTASection title="Une question avant de choisir ?" description="Écrivez-nous : nous vous répondons sous 24h." buttonLabel="Nous contacter" />
</BaseLayout>
