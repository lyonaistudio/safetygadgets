---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 sm:pt-5">
  <div class="hero-banner rounded-2xl px-5 py-6 sm:px-12 sm:py-14">
    <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-accent">{eyebrow}</p>
    <h1 class="mt-2 max-w-3xl font-display text-2xl font-semibold leading-tight text-paper sm:mt-3 sm:text-5xl">{title}</h1>
    {description && <p class="mt-2 max-w-2xl text-sm leading-relaxed text-paper-dim sm:mt-4 sm:text-lg">{description}</p>}
  </div>
</section>
