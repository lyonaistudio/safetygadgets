---
import { SITE } from "../lib/site";
import { NAV_LINKS_BY_LOCALE, UI, type Locale } from "../lib/i18n";
import { AUDIENCES } from "../data/audiences";

interface Props {
  lang?: Locale;
}

const { lang = "fr" } = Astro.props;
const t = UI[lang];
const navLinks = NAV_LINKS_BY_LOCALE[lang];
const year = new Date().getFullYear();
const cgvHref = lang === "fr" ? "/cgv/" : "/cgv/";
const legalHref = lang === "fr" ? "/mentions-legales/" : "/mentions-legales/";
---

<footer class="relative border-t border-ink-line bg-ink-soft">
  <div class="gold-rule pointer-events-none absolute inset-x-0 top-0" aria-hidden="true"></div>
  <div class={`mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-7 px-6 py-9 sm:py-16 md:gap-10 ${lang === "fr" ? "md:grid-cols-5" : "md:grid-cols-4"}`}>
    <div class="col-span-2">
      <div class="flex items-center gap-3">
        <img src="/logo/seal.png" alt="" width="44" height="44" class="h-11 w-11 object-contain" aria-hidden="true" />
        <p class="font-display text-lg text-paper">Safety Gadgets</p>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-mist sm:mt-4">
        {t.siteDescription}
      </p>
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.15em] text-mist">{t.footerNav}</p>
      <ul class="mt-3 space-y-1.5 sm:mt-4 sm:space-y-2">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-paper-dim transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    {lang === "fr" && (
      <div>
        <p class="text-xs uppercase tracking-[0.15em] text-mist">Solutions</p>
        <ul class="mt-3 space-y-1.5 sm:mt-4 sm:space-y-2">
          {AUDIENCES.map((a) => (
            <li>
              <a href={a.path} class="text-sm text-paper-dim transition-colors hover:text-accent">{a.navLabel}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class={lang === "fr" ? "col-span-2 md:col-span-1" : ""}>
      <p class="text-xs uppercase tracking-[0.15em] text-mist">{t.footerContact}</p>
      <ul class="mt-3 space-y-1.5 text-sm text-paper-dim sm:mt-4 sm:space-y-2">
        <li>
          <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-accent">{SITE.email}</a>
        </li>
        <li>{SITE.city}{t.footerShipping}</li>
        <li>{SITE.hours}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-5 text-xs text-mist sm:py-6 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.name}. {t.footerRights}</p>
      <div class="flex gap-4">
        <a href={cgvHref} class="transition-colors hover:text-accent">{t.footerCgv}</a>
        <a href={legalHref} class="transition-colors hover:text-accent">
          {t.footerLegal}
        </a>
      </div>
    </div>
  </div>
</footer>
