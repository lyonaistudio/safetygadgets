---
import { NAV_LINKS_BY_LOCALE, LOCALES, UI, HOME_SWITCHER, type Locale, type SwitcherLinks } from "../lib/i18n";

interface Props {
  lang?: Locale;
  switcherLinks?: SwitcherLinks;
}

const { lang = "fr", switcherLinks = HOME_SWITCHER } = Astro.props;
const t = UI[lang];
const navLinks = NAV_LINKS_BY_LOCALE[lang];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-ink-line bg-white/95 shadow-[0_1px_0_rgba(0,0,0,0.02)] backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <a href={switcherLinks[lang]} class="mr-6 flex shrink-0 items-center gap-2.5 xl:mr-12" aria-label="Safety Gadgets">
      <img src="/logo/seal.png" alt="" width="40" height="42" class="h-10 w-auto shrink-0 object-contain" aria-hidden="true" />
      <span class="leading-none">
        <span class="block font-display text-xl font-semibold tracking-tight text-paper">Safety</span>
        <span class="block text-[9px] font-semibold uppercase tracking-[0.38em] text-accent">Gadgets</span>
      </span>
    </a>

    <nav class="hidden items-center gap-4 xl:mr-8 xl:flex" aria-label="Navigation principale">
      {navLinks.map((link) => {
        const isActive = link.href === "/" || link.href === "/en/" || link.href === "/de/"
          ? currentPath === link.href
          : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`whitespace-nowrap rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-ink-soft hover:text-paper ${
              isActive ? "bg-night text-white hover:bg-night hover:text-white" : "text-paper"
            }`}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <div class="relative mr-2 hidden xl:block">
        <details class="group/lang">
          <summary
            class="flex h-9 cursor-pointer list-none items-center gap-1 rounded-md border border-ink-line px-2.5 text-xs uppercase tracking-[0.1em] text-paper-dim transition-colors hover:border-accent hover:text-accent marker:content-none"
            aria-label={t.langAria}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3c2.5 2.5 4 5.5 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.5-4-9s1.5-6.5 4-9Z" />
            </svg>
            {lang.toUpperCase()}
          </summary>
          <div class="absolute right-0 top-full z-50 mt-2 w-60 rounded-lg border border-ink-line bg-white p-2 shadow-xl">
            {LOCALES.map((l) => (
              <a
                href={switcherLinks[l.code]}
                class="flex items-center justify-between px-3 py-2 text-xs text-paper transition-colors hover:text-accent"
              >
                <span>{l.flag} {l.label}</span>
                {l.code === lang && <span class="text-accent" aria-hidden="true">✓</span>}
              </a>
            ))}
          </div>
        </details>
      </div>

      <a
        href={lang === "fr" ? "/panier/" : switcherLinks[lang]}
        class="relative flex h-9 w-9 items-center justify-center rounded-full text-paper transition-colors hover:bg-ink-soft hover:text-accent"
        aria-label={t.cartAria}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 4h2l2.4 11h11L21 7H6.2M9 20h.01M18 20h.01" />
        </svg>
        <span
          data-cart-count
          class="hidden absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-gold px-1 text-[10px] font-semibold text-night"
        >0</span>
      </a>

      <a
        href={lang === "fr" ? "/contact/" : `/${lang}/contact/`}
        class="hidden rounded-lg bg-gold px-5 py-2 text-sm font-semibold text-night transition-colors hover:bg-gold-soft xl:inline-block"
      >
        {t.contactCta}
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex flex-col gap-1.5 p-2 xl:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="h-0.5 w-6 bg-paper"></span>
      <span class="h-0.5 w-6 bg-paper"></span>
      <span class="h-0.5 w-6 bg-paper"></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-ink-line px-6 py-4 xl:hidden"
    aria-label="Navigation mobile"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="rounded-md px-2 py-3 text-sm text-paper transition-colors hover:bg-ink-soft"
      >
        {link.label}
      </a>
    ))}
    <a
      href={lang === "fr" ? "/contact/" : `/${lang}/contact/`}
      class="mt-2 rounded-lg bg-gold px-4 py-3 text-center text-sm font-semibold text-night"
    >
      {t.contactCta}
    </a>
  </nav>
</header>
