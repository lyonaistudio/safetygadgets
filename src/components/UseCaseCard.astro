---

<div class="reveal flex gap-4 py-6 sm:px-6 sm:py-8">
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-accent/50 text-accent">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d={icons[icon]} />
    </svg>
  </span>
  <div>
    <h3 class="font-display text-base text-paper">{title}</h3>
    <p class="mt-1 text-sm leading-relaxed text-paper-dim">{description}</p>
  </div>
</div>
