---
import type { Locale } from "../lib/i18n";
import { FORMSPREE_ENDPOINT } from "../lib/site";
import { reviewsFor, ratingSummary } from "../data/reviews";

// Avis clients d'une fiche produit : liste des avis publiés (src/data/
// reviews.ts) et formulaire de dépôt envoyé par email via Formspree. Les
// avis ne s'affichent qu'après vérification manuelle de la commande.
interface Props {
  slug: string;
  productName: string;
  lang?: Locale;
}
const { slug, productName, lang = "fr" } = Astro.props;
const reviews = reviewsFor(slug);
const summary = ratingSummary(slug);

const TEXT: Record<Locale, Record<string, string>> = {
  fr: {
    eyebrow: "Avis clients",
    title: "Ce qu'en disent nos clients",
    empty: "Aucun avis publié pour l'instant. Vous avez ce produit ? Votre retour aidera les prochains clients.",
    count: "avis",
    write: "Donner mon avis",
    name: "Prénom et initiale du nom",
    email: "Email utilisé pour la commande",
    rating: "Votre note",
    text: "Votre avis",
    submit: "Envoyer mon avis",
    legal: "Votre avis est publié après vérification de votre commande. Votre email n'est jamais affiché.",
    done: "Merci ! Votre avis sera publié après vérification.",
    error: "Une erreur est survenue, réessayez.",
  },
  en: {
    eyebrow: "Customer reviews",
    title: "What our customers say",
    empty: "No reviews published yet. Own this product? Your feedback will help future customers.",
    count: "reviews",
    write: "Write a review",
    name: "First name and last initial",
    email: "Email used for your order",
    rating: "Your rating",
    text: "Your review",
    submit: "Send my review",
    legal: "Your review is published once your order is verified. Your email is never shown.",
    done: "Thank you! Your review will be published after verification.",
    error: "Something went wrong, please try again.",
  },
  de: {
    eyebrow: "Kundenbewertungen",
    title: "Das sagen unsere Kunden",
    empty: "Noch keine Bewertungen veröffentlicht. Sie besitzen dieses Produkt? Ihr Feedback hilft künftigen Kunden.",
    count: "Bewertungen",
    write: "Bewertung schreiben",
    name: "Vorname und Initiale des Nachnamens",
    email: "E-Mail Ihrer Bestellung",
    rating: "Ihre Bewertung",
    text: "Ihr Kommentar",
    submit: "Bewertung senden",
    legal: "Ihre Bewertung wird nach Prüfung Ihrer Bestellung veröffentlicht. Ihre E-Mail wird nie angezeigt.",
    done: "Danke! Ihre Bewertung wird nach Prüfung veröffentlicht.",
    error: "Ein Fehler ist aufgetreten, bitte erneut versuchen.",
  },
};
const t = TEXT[lang];
const stars = (n: number) => "★★★★★".slice(0, Math.round(n)) + "☆☆☆☆☆".slice(0, 5 - Math.round(n));
const dateFmt = new Intl.DateTimeFormat(lang === "fr" ? "fr-FR" : lang === "de" ? "de-DE" : "en-GB", { month: "long", year: "numeric" });
---

<section id="avis" class="mx-auto max-w-6xl scroll-mt-32 px-4 py-8 sm:px-6 sm:py-14">
  <div class="grid gap-4 sm:gap-10 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <p class="hidden text-[11px] font-medium uppercase tracking-[0.3em] text-accent sm:block">{t.eyebrow}</p>
      <h2 class="font-display text-lg font-semibold text-paper sm:mt-2 sm:text-3xl">{t.title}</h2>
      {summary ? (
        <p class="mt-3 flex items-center gap-3">
          <span class="text-xl tracking-wider text-accent-soft" aria-hidden="true">{stars(summary.average)}</span>
          <span class="text-sm text-paper-dim">{summary.average.toLocaleString(lang)} / 5 · {summary.count} {t.count}</span>
        </p>
      ) : (
        <p class="mt-1.5 max-w-md text-xs leading-relaxed text-paper-dim sm:mt-3 sm:text-sm">{t.empty}</p>
      )}
      {reviews.length > 0 && (
        <div class="mt-4 space-y-3 sm:mt-6 sm:space-y-4">
          {reviews.map((r) => (
          <article class="rounded-xl border border-ink-line bg-white p-5">
            <p class="text-accent-soft" aria-label={`${r.rating} / 5`}>{stars(r.rating)}</p>
            <p class="mt-2 text-sm leading-relaxed text-paper">{r.text}</p>
            <p class="mt-3 text-xs text-mist">{r.name}{r.city && ` · ${r.city}`} · {dateFmt.format(new Date(r.date))}</p>
          </article>
          ))}
        </div>
      )}
    </div>

    <details data-open-desktop class="group rounded-2xl bg-ink-soft p-4 sm:p-7">
      <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-paper marker:content-none sm:cursor-default sm:text-base">
        {t.write}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-accent transition-transform group-open:rotate-180 sm:hidden" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <form data-review-form action={FORMSPREE_ENDPOINT} method="POST" class="mt-4 grid gap-3">
        <input type="hidden" name="_subject" value={`Nouvel avis — ${productName}`} />
        <input type="hidden" name="produit" value={slug} />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <fieldset>
          <legend class="text-xs text-paper-dim">{t.rating}</legend>
          <div class="review-stars mt-1 flex flex-row-reverse justify-end gap-1 text-2xl">
            {[5, 4, 3, 2, 1].map((n) => (
              <label class="cursor-pointer text-ink-line transition-colors">
                <input type="radio" name="note" value={n} required class="sr-only" />
                <span aria-hidden="true">★</span>
                <span class="sr-only">{n} / 5</span>
              </label>
            ))}
          </div>
        </fieldset>
        <input name="nom" required maxlength="40" placeholder={t.name} class="rounded-lg border border-ink-line bg-white px-4 py-2.5 text-sm text-paper outline-none focus:border-accent" />
        <input type="email" name="email" required placeholder={t.email} autocomplete="email" class="rounded-lg border border-ink-line bg-white px-4 py-2.5 text-sm text-paper outline-none focus:border-accent" />
        <textarea name="avis" required minlength="10" maxlength="1000" rows="4" placeholder={t.text} class="rounded-lg border border-ink-line bg-white px-4 py-2.5 text-sm text-paper outline-none focus:border-accent"></textarea>
        <button type="submit" class="w-fit rounded-lg bg-night px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-night-soft">{t.submit}</button>
        <p data-review-status hidden class="text-sm"></p>
        <p class="text-[11px] leading-snug text-mist">{t.legal}</p>
      </form>
    </details>
  </div>
</section>

<script define:vars={{ done: t.done, error: t.error }}>
  document.querySelectorAll("[data-review-form]").forEach((form) => {
    if (form.dataset.wired) return;
    form.dataset.wired = "true";
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const status = form.querySelector("[data-review-status]");
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        form.querySelectorAll("input:not([type=hidden]), textarea, button, fieldset").forEach((el) => (el.disabled = true));
        status.textContent = done;
        status.className = "text-sm text-signal";
      } catch {
        status.textContent = error;
        status.className = "text-sm text-promo";
      }
      status.hidden = false;
    });
  });
</script>

<style>
  /* Étoiles affichées de 1 à 5 (ordre DOM inversé) : survoler ou cocher une
     étoile colore aussi celles qui la précèdent visuellement. */
  .review-stars label:hover,
  .review-stars label:hover ~ label,
  .review-stars label:has(:checked),
  .review-stars label:has(:checked) ~ label {
    color: var(--color-accent-soft);
  }
  .review-stars label:has(:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
