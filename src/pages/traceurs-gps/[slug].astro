---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CTASection from "../../components/CTASection.astro";
import UseCaseCard from "../../components/UseCaseCard.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { PRODUCTS, formatPriceTTC } from "../../data/products";
import { productSchema, faqSchema } from "../../lib/schema";

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const schema = productSchema({
  name: product.name,
  description: product.shortDescription,
  image: product.image,
  slug: product.slug,
  price: product.price,
  currency: product.currency,
  sku: product.sku,
});

const formattedPrice = formatPriceTTC(product.price, product.currency);
const qtyInputId = `qty-${product.slug}`;
const schemas = product.faq && product.faq.length > 0 ? [schema, faqSchema(product.faq)] : [schema];
---

<BaseLayout
  title={`${product.name} — Safety Gadgets`}
  description={product.shortDescription}
  path={`/traceurs-gps/${product.slug}/`}
  jsonLd={schemas}
>
  <Breadcrumb
    items={[
      { name: "Nos produits", url: "/traceurs-gps/" },
      { name: product.name, url: `/traceurs-gps/${product.slug}/` },
    ]}
  />

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <div class="reveal flex justify-center">
        <div
          class="w-full max-w-sm"
          data-product-gallery
          data-gallery-images={JSON.stringify(product.gallery ?? [product.image])}
        >
          <div class="product-stage border border-ink-line bg-ink-soft p-10">
            <img
              src={product.image}
              alt={product.name}
              width="360"
              height="360"
              data-gallery-main
              class="premium-photo mx-auto h-64 w-auto object-contain sm:h-72"
            />
            {product.gallery && product.gallery.length > 1 && (
              <>
                <button
                  type="button"
                  data-gallery-prev
                  class="absolute left-3 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center border border-ink-line bg-ink/80 text-paper-dim transition-colors hover:border-accent hover:text-accent"
                  aria-label="Photo précédente"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                </button>
                <button
                  type="button"
                  data-gallery-next
                  class="absolute right-3 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center border border-ink-line bg-ink/80 text-paper-dim transition-colors hover:border-accent hover:text-accent"
                  aria-label="Photo suivante"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
                </button>
              </>
            )}
          </div>
          {product.gallery && product.gallery.length > 1 && (
            <div class="mt-4 flex justify-center gap-3">
              {product.gallery.map((src, i) => (
                <button
                  type="button"
                  data-gallery-thumb={src}
                  class={`h-16 w-16 shrink-0 border bg-ink-soft p-2 transition-colors ${
                    i === 0 ? "border-accent" : "border-ink-line"
                  }`}
                  aria-label={`Voir la photo ${i + 1} de ${product.name}`}
                >
                  <img src={src} alt="" width="64" height="64" class="h-full w-full object-contain" aria-hidden="true" />
                </button>
              ))}
            </div>
          )}
        </div>
      </div>
      <div class="reveal">
        <Eyebrow label={product.category} />
        <h1 class="mt-4 font-display text-3xl font-medium text-paper sm:text-4xl">{product.name}</h1>
        <p class="mt-3 flex flex-wrap items-baseline gap-3 font-mono text-2xl text-accent">
          {formattedPrice}
          {product.originalPrice && (
            <>
              <span class="text-base text-mist line-through">{formatPriceTTC(product.originalPrice, product.currency)}</span>
              <span class="text-xs uppercase tracking-[0.1em] text-signal">
                −{formatPriceTTC(product.originalPrice - product.price, product.currency)}
              </span>
            </>
          )}
        </p>
        <p class="mt-2 flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist">
          <span class="live-dot" aria-hidden="true"></span> En stock — expédition sous 24 à 48h
        </p>
        <p class="mt-5 max-w-xl leading-relaxed text-paper-dim">{product.description}</p>

        <ul class="mt-6 space-y-2 border-t border-ink-line pt-6">
          {product.highlights.map((point) => (
            <li class="flex gap-3 text-sm text-paper-dim">
              <span class="mt-1 h-1 w-1 shrink-0 bg-accent" aria-hidden="true"></span>
              {point}
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <div class="flex items-center border border-ink-line">
            <button
              type="button"
              data-qty-target={qtyInputId}
              data-qty-step="-1"
              class="px-3 py-2.5 text-paper-dim transition-colors hover:text-accent"
              aria-label="Diminuer la quantité"
            >
              −
            </button>
            <input
              id={qtyInputId}
              type="number"
              min="1"
              value="1"
              class="w-12 border-x border-ink-line bg-transparent py-2.5 text-center font-mono text-sm text-paper [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
            />
            <button
              type="button"
              data-qty-target={qtyInputId}
              data-qty-step="1"
              class="px-3 py-2.5 text-paper-dim transition-colors hover:text-accent"
              aria-label="Augmenter la quantité"
            >
              +
            </button>
          </div>
          <button
            type="button"
            data-add-to-cart={product.slug}
            data-qty-input={qtyInputId}
            class="border border-accent bg-accent px-6 py-3 text-xs uppercase tracking-[0.15em] text-ink transition-colors hover:bg-ink hover:text-accent"
          >
            Ajouter au panier
          </button>
        </div>
        <a
          href="/contact/"
          class="mt-4 inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist transition-colors hover:text-accent"
        >
          Une question avant d'acheter ? <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-y border-ink-line bg-ink-soft">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <Eyebrow label="Caractéristiques" />
      <h2 class="mt-4 max-w-2xl font-display text-2xl font-medium text-paper sm:text-3xl">
        Fiche technique
      </h2>
      <dl class="mt-8 grid gap-x-8 gap-y-4 border-t border-ink-line pt-6 sm:grid-cols-2">
        {product.specs.map((spec) => (
          <div class="flex justify-between gap-4 border-b border-ink-line pb-3">
            <dt class="text-xs uppercase tracking-[0.1em] text-mist">{spec.label}</dt>
            <dd class="text-right font-mono text-sm text-paper-dim">{spec.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <Eyebrow label="Cas d'usage" />
    <h2 class="mt-4 max-w-2xl font-display text-2xl font-medium text-paper sm:text-3xl">
      Pour qui est fait ce produit ?
    </h2>
    <div class="mt-8 grid gap-x-8 sm:grid-cols-2 sm:divide-x sm:divide-ink-line lg:grid-cols-4">
      {product.useCases.map((useCase) => (
        <UseCaseCard {...useCase} />
      ))}
    </div>
  </section>

  {product.faq && product.faq.length > 0 && (
    <section class="border-t border-ink-line bg-ink-soft">
      <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
        <Eyebrow label="Questions fréquentes" />
        <h2 class="mt-4 max-w-2xl font-display text-2xl font-medium text-paper sm:text-3xl">
          Sur ce produit précisément.
        </h2>
        <div class="mt-8">
          <FAQAccordion items={product.faq} />
        </div>
        <a
          href="/faq/"
          class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist transition-colors hover:text-accent"
        >
          Voir toute la FAQ <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}

  <CTASection
    title="Prêt à commander ?"
    description="Contactez-nous pour finaliser votre commande ou pour toute question avant achat."
    buttonLabel="Nous contacter"
  />
</BaseLayout>
