---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductDetail from "../../components/ProductDetail.astro";
import { PRODUCTS } from "../../data/products";
import { productSchema, faqSchema } from "../../lib/schema";
import { ratingSummary } from "../../data/reviews";

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const schema = productSchema({
  name: product.name,
  description: product.shortDescription,
  image: product.image,
  slug: product.slug,
  price: product.price,
  currency: product.currency,
  sku: product.sku,
  rating: ratingSummary(product.slug),
});
const schemas = product.faq && product.faq.length > 0 ? [schema, faqSchema(product.faq)] : [schema];
---

<BaseLayout
  title={`${product.name} — Safety Gadgets`}
  description={product.shortDescription}
  path={`/traceurs-gps/${product.slug}/`}
  jsonLd={schemas}
>
  <Breadcrumb
    items={[
      { name: "Nos produits", url: "/traceurs-gps/" },
      { name: product.name, url: `/traceurs-gps/${product.slug}/` },
    ]}
  />
  <ProductDetail product={product} catalog={PRODUCTS} lang="fr" />
</BaseLayout>
