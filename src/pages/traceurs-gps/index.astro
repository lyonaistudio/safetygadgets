---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CTASection from "../../components/CTASection.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { PRODUCTS, formatPriceTTC } from "../../data/products";
import { faqSchema } from "../../lib/schema";

const faqItems = [
  {
    question: "Quel produit choisir selon mon besoin ?",
    answer: "Pour un véhicule : GF07 ou OBD. Pour un sac ou des clés : le tag Bluetooth. Pour repérer une surveillance : le détecteur. Pour une alerte d'urgence : l'alarme SOS.",
  },
  {
    question: "Les prix affichés sont-ils TTC ?",
    answer: "Oui, tous les prix affichés sont toutes taxes comprises, sans frais cachés à la commande.",
  },
  {
    question: "Livrez-vous en dehors de la France ?",
    answer: "Contactez-nous avec votre adresse de livraison pour vérifier la disponibilité et les délais.",
  },
];
const schema = faqSchema(faqItems);

// Mêmes trois groupes que sur la page d'accueil : les 2 produits phares
// disponibles en grand format, le pack juste en dessous en rappel compact,
// et le reste — pas encore arrivé — en retrait et flouté pour le suspense.
const heroProducts = PRODUCTS.filter((p) => p.slug === "obd" || p.slug === "alarme-sos");
const bundleProduct = PRODUCTS.find((p) => p.slug === "pack-decouverte");
const comingSoonProducts = PRODUCTS.filter((p) => p.comingSoon);
---

<BaseLayout
  title="Nos produits — Safety Gadgets"
  description="Découvrez la sélection Safety Gadgets : trackers GPS, trackers Bluetooth et détecteurs anti-espionnage compacts et fiables, testés pour leur usage au quotidien."
  path="/traceurs-gps/"
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "Nos produits", url: "/traceurs-gps/" }]} />
  <PageHero
    eyebrow="BOUTIQUE"
    title="Nos produits"
    description="Une sélection resserrée de trackers et de détecteurs compacts, testés pour leur fiabilité au quotidien."
  />

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid gap-6 sm:grid-cols-2">
      {heroProducts.map((product) => (
        <div class="reveal group card-lift relative flex flex-col overflow-hidden border border-accent/60 bg-ink-soft p-4 shadow-[0_0_0_1px_rgba(201,162,39,0.2)] sm:p-6">
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-accent/[0.08] via-transparent to-transparent" aria-hidden="true"></div>
          <div class="relative flex items-center justify-between gap-3">
            {product.badge && (
              <span class="inline-block w-fit border border-accent bg-ink px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] text-accent">
                {product.badge}
              </span>
            )}
            <span class="text-[10px] uppercase tracking-[0.15em] text-mist">{product.category}</span>
          </div>
          <a href={`/traceurs-gps/${product.slug}/`} class="relative flex flex-1 flex-col">
            <div class="product-stage relative my-3 h-36 sm:h-44">
              <img
                src={product.image}
                alt={product.name}
                width="200"
                height="200"
                class="premium-photo mx-auto h-36 w-36 object-contain sm:h-44 sm:w-44"
              />
            </div>
            <h2 class="font-display text-lg text-paper group-hover:text-accent sm:text-xl">
              {product.name}
            </h2>
            <p class="mt-1.5 text-xs leading-relaxed text-paper-dim sm:text-sm">{product.tagline}</p>
          </a>
          <p class="relative mt-3 flex flex-wrap items-baseline gap-2 font-mono text-lg text-accent">
            {formatPriceTTC(product.price, product.currency)}
            {product.originalPrice && (
              <span class="text-xs text-mist line-through">{formatPriceTTC(product.originalPrice, product.currency)}</span>
            )}
          </p>
          <div class="relative mt-4 flex flex-wrap items-center gap-3">
            <button
              type="button"
              data-add-to-cart={product.slug}
              class="border border-accent bg-accent px-4 py-2 text-xs uppercase tracking-[0.15em] text-ink transition-colors hover:bg-ink hover:text-accent"
            >
              Ajouter au panier
            </button>
            <a
              href={`/traceurs-gps/${product.slug}/`}
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist transition-colors hover:text-accent"
            >
              Voir la fiche <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    {bundleProduct && (
      <div class="reveal card-lift mt-6 flex flex-col gap-4 border border-ink-line bg-ink p-5 transition-colors duration-200 hover:border-accent/60 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <a href={`/traceurs-gps/${bundleProduct.slug}/`} class="flex items-center gap-4">
          <img
            src={bundleProduct.image}
            alt={bundleProduct.name}
            width="72"
            height="72"
            class="premium-photo h-14 w-14 shrink-0 object-contain sm:h-16 sm:w-16"
          />
          <div>
            {bundleProduct.badge && (
              <span class="text-[10px] uppercase tracking-[0.15em] text-accent">{bundleProduct.badge}</span>
            )}
            <h2 class="font-display text-base text-paper">{bundleProduct.name}</h2>
            <p class="mt-0.5 text-xs leading-relaxed text-paper-dim">{bundleProduct.tagline}</p>
          </div>
        </a>
        <div class="flex shrink-0 flex-wrap items-center gap-4 sm:justify-end">
          <p class="flex items-baseline gap-2 font-mono text-base text-accent">
            {formatPriceTTC(bundleProduct.price, bundleProduct.currency)}
            {bundleProduct.originalPrice && (
              <span class="text-xs text-mist line-through">{formatPriceTTC(bundleProduct.originalPrice, bundleProduct.currency)}</span>
            )}
          </p>
          <button
            type="button"
            data-add-to-cart={bundleProduct.slug}
            class="border border-accent bg-accent px-4 py-2 text-xs uppercase tracking-[0.15em] text-ink transition-colors hover:bg-ink hover:text-accent"
          >
            Ajouter au panier
          </button>
        </div>
      </div>
    )}

    {comingSoonProducts.length > 0 && (
      <div class="mt-16 border-t border-ink-line pt-10 sm:mt-20">
        <Eyebrow label="Bientôt disponible" />
        <h2 class="mt-3 max-w-xl font-display text-lg font-medium text-paper sm:text-xl">
          D'autres protections arrivent bientôt.
        </h2>
        <div class="mt-6 grid grid-cols-3 gap-3 sm:gap-4">
          {comingSoonProducts.map((product) => (
            <div class="reveal relative flex flex-col items-center border border-ink-line/60 bg-ink-soft/50 p-3 text-center sm:p-5">
              <div class="product-stage relative my-2 h-20 w-20 sm:h-28 sm:w-28">
                <img
                  src={product.image}
                  alt={product.name}
                  width="140"
                  height="140"
                  class="premium-photo h-20 w-20 object-contain opacity-20 blur-md grayscale sm:h-28 sm:w-28"
                />
                <span class="absolute inset-0 flex items-center justify-center">
                  <span class="border border-accent/70 bg-ink/90 px-2 py-1 text-[9px] uppercase tracking-[0.15em] text-accent sm:px-2.5 sm:text-[10px]">
                    Bientôt révélé
                  </span>
                </span>
              </div>
              <p class="text-[10px] uppercase tracking-[0.1em] text-mist sm:text-[11px]">{product.category}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <Eyebrow label="Questions fréquentes" />
    <h2 class="mt-4 max-w-2xl font-display text-2xl font-medium text-paper sm:text-3xl">
      Avant de choisir
    </h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
    <a
      href="/faq/"
      class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist transition-colors hover:text-accent"
    >
      Voir toute la FAQ <span aria-hidden="true">→</span>
    </a>
  </section>

  <CTASection
    title="Un besoin précis en tête ?"
    description="Dites-nous ce que vous cherchez à sécuriser, nous vous orientons vers le bon produit."
    buttonLabel="Nous contacter"
  />
</BaseLayout>
