---
import ProductQuiz from "../../components/ProductQuiz.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CTASection from "../../components/CTASection.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { PRODUCTS } from "../../data/products";
import { faqSchema } from "../../lib/schema";

const faqItems = [
  {
    question: "Quel produit choisir selon mon besoin ?",
    answer: "Pour surveiller un véhicule : le tracker GPS OBD. Pour vous ou un proche, en cas d'urgence : l'alarme porte-clés SOS.",
  },
  {
    question: "Les prix affichés sont-ils TTC ?",
    answer: "Oui, tous les prix affichés sont toutes taxes comprises, sans frais cachés à la commande.",
  },
  {
    question: "Livrez-vous en dehors de la France ?",
    answer: "Contactez-nous avec votre adresse de livraison pour vérifier la disponibilité et les délais.",
  },
];
const schema = faqSchema(faqItems);

---

<BaseLayout
  title="Nos produits — Safety Gadgets"
  description="Le tracker GPS OBD et l'alarme porte-clés SOS de Safety Gadgets — deux produits testés et garantis un an."
  path="/traceurs-gps/"
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "Nos produits", url: "/traceurs-gps/" }]} />
  <PageHero
    eyebrow="BOUTIQUE"
    title="Nos produits"
    description="Un tracker GPS pour votre véhicule, une alarme SOS pour vous — deux produits essentiels, testés pour leur fiabilité au quotidien."
  />

  <section class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 sm:pt-10">
    <div class="grid gap-5 sm:grid-cols-2">
      {PRODUCTS.filter((p) => !p.comingSoon).map((product) => <ProductCard product={product} lang="fr" />)}
    </div>
  </section>

  <ProductQuiz />

  <section class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 sm:pt-14">
    <p class="hidden text-[11px] font-medium uppercase tracking-[0.3em] text-accent sm:block">Prochainement</p>
    <h2 class="font-display text-lg font-semibold text-paper sm:mt-2 sm:text-3xl">D'autres protections arrivent bientôt.</h2>
    <div class="mt-3 grid grid-cols-3 gap-2 sm:mt-6 sm:gap-5">
      {PRODUCTS.filter((p) => p.comingSoon).map((p) => (
        <a href={`/traceurs-gps/${p.slug}/`} class="relative flex flex-col items-center rounded-xl border border-ink-line bg-white p-2.5 text-center sm:rounded-2xl sm:p-4">
          <span class="absolute left-2 top-2 rounded bg-night px-1.5 py-0.5 text-[8px] font-semibold uppercase tracking-wide text-gold sm:left-3 sm:top-3 sm:px-2 sm:text-[9px]">Bientôt</span>
          <img src={p.image} alt="" width="120" height="120" class="mt-4 h-12 w-12 object-contain opacity-30 blur-[3px] grayscale sm:h-28 sm:w-28" />
          <p class="mt-2 text-[11px] font-medium leading-tight text-paper sm:mt-3 sm:text-sm">{p.category}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-10 sm:py-20">
    <Eyebrow label="Questions fréquentes" />
    <h2 class="mt-4 max-w-2xl font-display text-2xl font-medium text-paper sm:text-3xl">
      Avant de choisir
    </h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
    <a
      href="/faq/"
      class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist transition-colors hover:text-accent"
    >
      Voir toute la FAQ <span aria-hidden="true">→</span>
    </a>
  </section>

  <CTASection
    title="Un besoin précis en tête ?"
    description="Dites-nous ce que vous cherchez à sécuriser, nous vous orientons vers le bon produit."
    buttonLabel="Nous contacter"
  />
</BaseLayout>
