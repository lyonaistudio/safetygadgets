---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";
import { faqSchema } from "../lib/schema";

const faqItems = [
  {
    question: "Le tracker a-t-il besoin d'une carte SIM ?",
    answer:
      "Oui. Le tracker communique sa position par réseau GSM/GPRS, il faut donc y insérer une carte SIM classique avec un forfait data actif (non fournie). Sans carte SIM, seule la fonction GPS locale reste disponible.",
  },
  {
    question: "Est-il compatible avec tous les opérateurs mobiles ?",
    answer:
      "Le tracker fonctionne sur les réseaux 2G/GPRS. Vérifiez avant l'achat de votre carte SIM que votre opérateur maintient une couverture 2G active dans la zone d'utilisation prévue, certains opérateurs réduisent progressivement ce réseau.",
  },
  {
    question: "Quelle est l'autonomie réelle de la batterie ?",
    answer:
      "Entre 12 et 24h selon la fréquence de mise à jour de la position et la qualité du signal GSM/GPS. Un usage avec des envois de position espacés prolonge l'autonomie.",
  },
  {
    question: "Quelle est la précision de la localisation ?",
    answer:
      "En extérieur avec un bon signal, le positionnement GPS est précis à quelques mètres. En intérieur ou en zone urbaine dense, le tracker bascule sur AGPS/GSM/LBS, moins précis mais toujours utile pour situer une zone.",
  },
  {
    question: "Quels sont les délais de livraison ?",
    answer:
      "Les commandes sont préparées et expédiées sous 24 à 48h ouvrées, avec un numéro de suivi communiqué par email dès l'envoi.",
  },
  {
    question: "Puis-je retourner le produit s'il ne me convient pas ?",
    answer:
      "Oui, un retour est possible dans les 30 jours suivant la réception, produit non utilisé et dans son emballage d'origine. Contactez-nous pour lancer la procédure.",
  },
  {
    question: "Que couvre la garantie d'un an ?",
    answer:
      "La garantie couvre les défauts de fabrication et pannes survenant dans un usage normal du produit pendant un an à compter de l'achat. Contactez-nous avec votre preuve d'achat pour tout problème.",
  },
  {
    question: "Proposez-vous des tarifs pour les professionnels ou les commandes en volume ?",
    answer:
      "Oui. Entreprises, associations et collectivités peuvent nous contacter directement (formulaire de contact, motif « Professionnel / commande en volume ») pour un devis avec tarif dégressif et facturation professionnelle, adapté à la quantité souhaitée.",
  },
];

const schema = faqSchema(faqItems);
---

<BaseLayout
  title="FAQ — Questions fréquentes — Safety Gadgets"
  description="Réponses aux questions les plus fréquentes sur nos trackers : carte SIM, autonomie, précision, livraison et garantie."
  path="/faq/"
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "FAQ", url: "/faq/" }]} />
  <PageHero eyebrow="FAQ" title="Questions fréquentes" />

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <FAQAccordion items={faqItems} />
  </section>

  <CTASection
    title="Vous ne trouvez pas de réponse à votre question ?"
    description="Contactez-nous directement, nous répondons personnellement à chaque message."
    buttonLabel="Nous contacter"
  />
</BaseLayout>
