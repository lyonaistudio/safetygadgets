---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";
import { faqSchema } from "../lib/schema";

const faqItems = [
  {
    question: "Le tracker GPS OBD a-t-il besoin d'une carte SIM ?",
    answer:
      "Oui. Il transmet sa position via le réseau 4G, il faut donc y insérer une carte SIM avec un forfait data actif (non fournie).",
  },
  {
    question: "Comment installe-t-on le tracker OBD ?",
    answer:
      "Il se branche directement sur la prise OBD du véhicule, sans câblage ni outil — en quelques secondes. Compatible avec la plupart des véhicules (12-36V).",
  },
  {
    question: "Que se passe-t-il si quelqu'un débranche le tracker ?",
    answer:
      "Sa batterie de secours prend le relais jusqu'à 2h, le temps de réagir, et une alerte de débranchement peut être configurée.",
  },
  {
    question: "L'alarme porte-clés SOS a-t-elle besoin d'une carte SIM ou d'une application ?",
    answer:
      "Non. Elle fonctionne en sans-fil dès la sortie de la boîte : une pression sur le bouton déclenche une sirène de 130 dB, envoie un SMS et appelle vos contacts d'urgence avec votre position GPS.",
  },
  {
    question: "Quelle est l'autonomie de l'alarme SOS ?",
    answer:
      "Jusqu'à 2h d'utilisation continue sur sa batterie rechargeable — largement suffisant pour un usage ponctuel d'urgence.",
  },
  {
    question: "Quels sont les délais de livraison ?",
    answer:
      "Les commandes sont préparées et expédiées sous 24 à 48h ouvrées, avec un numéro de suivi communiqué par email dès l'envoi.",
  },
  {
    question: "Puis-je retourner un produit s'il ne me convient pas ?",
    answer:
      "Oui, un retour est possible dans les 30 jours suivant la réception, produit non utilisé et dans son emballage d'origine. Contactez-nous pour lancer la procédure.",
  },
  {
    question: "Que couvre la garantie d'un an ?",
    answer:
      "La garantie couvre les défauts de fabrication et pannes survenant dans un usage normal du produit pendant un an à compter de l'achat. Contactez-nous avec votre preuve d'achat pour tout problème.",
  },
  {
    question: "Proposez-vous des tarifs pour les professionnels ou les commandes en volume ?",
    answer:
      "Oui. Entreprises, associations et collectivités peuvent nous contacter directement (formulaire de contact, motif « Professionnel / commande en volume ») pour un devis avec tarif dégressif et facturation professionnelle, adapté à la quantité souhaitée.",
  },
];

const schema = faqSchema(faqItems);
---

<BaseLayout
  title="FAQ — Questions fréquentes — Safety Gadgets"
  description="Réponses aux questions les plus fréquentes sur notre tracker GPS OBD et notre alarme porte-clés SOS : installation, autonomie, livraison et garantie."
  path="/faq/"
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "FAQ", url: "/faq/" }]} />
  <PageHero eyebrow="FAQ" title="Questions fréquentes" />

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <FAQAccordion items={faqItems} />
  </section>

  <CTASection
    title="Vous ne trouvez pas de réponse à votre question ?"
    description="Contactez-nous directement, nous répondons personnellement à chaque message."
    buttonLabel="Nous contacter"
  />
</BaseLayout>
