---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { SITE } from "../lib/site";
---

<BaseLayout
  title="Commande confirmée — Safety Gadgets"
  description="Votre commande a été confirmée."
  path="/commande-confirmee/"
  noindex
>
  <PageHero eyebrow="MERCI" title="Votre commande est confirmée" description="Un e-mail de confirmation vous a été envoyé par Stripe avec le détail de votre paiement." />

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-center text-paper-dim">
      Nous préparons votre expédition sous 24 à 48h. Pour toute question sur votre commande, écrivez-nous à{" "}
      <a href={`mailto:${SITE.email}`} class="text-accent underline">{SITE.email}</a>.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl bg-ink-soft p-6">
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-accent">Votre avis compte</p>
        <p class="mt-2 font-display text-xl font-semibold text-paper">Dans quelques jours, dites-nous ce que vous en pensez</p>
        <p class="mt-2 text-sm leading-relaxed text-paper-dim">Une fois votre produit en main, votre avis sur sa fiche aide les prochains clients à choisir.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/traceurs-gps/obd/#avis" class="rounded-lg border border-ink-line bg-white px-3 py-2 text-xs font-medium text-paper hover:border-accent">Avis Tracker OBD</a>
          <a href="/traceurs-gps/alarme-sos/#avis" class="rounded-lg border border-ink-line bg-white px-3 py-2 text-xs font-medium text-paper hover:border-accent">Avis Alarme SOS</a>
        </div>
      </div>
      <div class="hero-banner rounded-2xl p-6">
        <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-accent">Offrez −10 % à un proche</p>
        <p class="mt-2 font-display text-xl font-semibold text-paper">Partagez la protection autour de vous</p>
        <p class="mt-2 text-sm leading-relaxed text-paper-dim">Avec le code <strong class="font-mono text-paper">BIENVENUE10</strong>, votre proche bénéficie de −10 % sur sa première commande.</p>
        <button type="button" data-share class="mt-4 rounded-lg bg-night px-4 py-2.5 text-sm font-semibold text-white hover:bg-night-soft">Partager avec un proche</button>
        <p data-share-done hidden class="mt-2 text-xs text-signal">Message copié, il ne reste plus qu'à le coller.</p>
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href="/traceurs-gps/" class="inline-block rounded-lg border border-ink-line px-6 py-3 text-sm text-paper-dim transition-colors hover:border-accent hover:text-accent">
        Continuer mes achats
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { clearCart, getCart } from "../lib/cart";
  import { PRODUCTS } from "../data/products";
  import { trackEvent } from "../lib/analytics";

  document.addEventListener(
    "astro:page-load",
    () => {
      // Mesure de la vente (si l'audience est acceptée), puis vidage du panier.
      const lines = getCart()
        .map((l) => ({ l, p: PRODUCTS.find((p) => p.slug === l.slug) }))
        .filter((x) => x.p);
      if (lines.length) {
        trackEvent("purchase", {
          transaction_id: new URLSearchParams(location.search).get("session_id") ?? undefined,
          currency: "EUR",
          value: lines.reduce((sum, { l, p }) => sum + p!.price * l.qty, 0),
          items: lines.map(({ l, p }) => ({ item_id: p!.sku, item_name: p!.name, price: p!.price, quantity: l.qty })),
        });
      }
      clearCart();

      const btn = document.querySelector<HTMLButtonElement>("[data-share]");
      btn?.addEventListener("click", async () => {
        const text = "Je viens de m'équiper chez Safety Gadgets. Avec le code BIENVENUE10, tu as -10 % sur ta première commande :";
        const url = "https://safety-gadgets.com/";
        if (navigator.share) {
          await navigator.share({ text, url }).catch(() => {});
        } else {
          await navigator.clipboard?.writeText(`${text} ${url}`);
          const done = document.querySelector<HTMLElement>("[data-share-done]");
          if (done) done.hidden = false;
        }
      });
    },
    { once: true }
  );
</script>
