---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ProductDetail from "../../../components/ProductDetail.astro";
import { PRODUCTS_DE } from "../../../data/products.de";
import { productSchema, faqSchema } from "../../../lib/schema";
import { ratingSummary } from "../../../data/reviews";
import { productSwitcher } from "../../../lib/i18n";

export function getStaticPaths() {
  return PRODUCTS_DE.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const schema = productSchema({
  name: product.name,
  description: product.shortDescription,
  image: product.image,
  slug: product.slug,
  price: product.price,
  currency: product.currency,
  sku: product.sku,
  rating: ratingSummary(product.slug),
});
const schemas = product.faq && product.faq.length > 0 ? [schema, faqSchema(product.faq)] : [schema];
---

<BaseLayout
  title={`${product.name} — Safety Gadgets`}
  description={product.shortDescription}
  path={`/de/traceurs-gps/${product.slug}/`}
  lang="de"
  switcherLinks={productSwitcher(product.slug)}
  jsonLd={schemas}
>
  <Breadcrumb
    items={[
      { name: "Unsere Produkte", url: "/de/traceurs-gps/" },
      { name: product.name, url: `/de/traceurs-gps/${product.slug}/` },
    ]}
    homeLabel="Startseite"
    homeUrl="/de/"
  />
  <ProductDetail product={product} catalog={PRODUCTS_DE} lang="de" />
</BaseLayout>
