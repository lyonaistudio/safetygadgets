---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import PageHero from "../../../components/PageHero.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import CTASection from "../../../components/CTASection.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import FAQAccordion from "../../../components/FAQAccordion.astro";
import { PRODUCTS_DE } from "../../../data/products.de";
import { formatPriceTTC } from "../../../data/products";
import { faqSchema } from "../../../lib/schema";
import { PAGE_SWITCHERS } from "../../../lib/i18n";

const faqItems = [
  {
    question: "Welches Produkt sollte ich wählen?",
    answer: "Für ein Fahrzeug: GF07 oder OBD. Für eine Tasche oder Schlüssel: der Bluetooth-Anhänger. Um Überwachung zu erkennen: der Detektor. Für einen Notfallalarm: der SOS-Alarm.",
  },
  {
    question: "Sind die angezeigten Preise inklusive MwSt.?",
    answer: "Ja, alle angezeigten Preise verstehen sich inklusive Mehrwertsteuer, ohne versteckte Kosten an der Kasse.",
  },
  {
    question: "Liefern Sie auch außerhalb Frankreichs?",
    answer: "Kontaktieren Sie uns mit Ihrer Lieferadresse, um Verfügbarkeit und Lieferzeiten zu prüfen.",
  },
];
const schema = faqSchema(faqItems);
---

<BaseLayout
  title="Unsere Produkte — Safety Gadgets"
  description="Entdecken Sie das Safety-Gadgets-Sortiment: GPS-Tracker, Bluetooth-Tracker und kompakte Spionage-Detektoren, getestet für den Alltag."
  path="/de/traceurs-gps/"
  lang="de"
  switcherLinks={PAGE_SWITCHERS.products}
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "Unsere Produkte", url: "/de/traceurs-gps/" }]} homeLabel="Startseite" homeUrl="/de/" />
  <PageHero
    eyebrow="SHOP"
    title="Unsere Produkte"
    description="Eine sorgfältig ausgewählte Reihe von Trackern und kompakten Detektoren, getestet für zuverlässigen Alltagseinsatz."
  />

  <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {PRODUCTS_DE.filter((p) => !p.comingSoon).map((product) => <ProductCard product={product} lang="de" />)}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6">
    <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-accent">Demnächst</p>
    <h2 class="mt-2 font-display text-2xl font-semibold text-paper sm:text-3xl">Weitere Produkte folgen in Kürze.</h2>
    <div class="mt-6 grid grid-cols-3 gap-3 sm:gap-5">
      {PRODUCTS_DE.filter((p) => p.comingSoon).map((p) => (
        <a href={`/de/traceurs-gps/${p.slug}/`} class="relative flex flex-col items-center rounded-2xl border border-ink-line bg-white p-4 text-center">
          <span class="absolute left-3 top-3 rounded bg-night px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-gold">Demnächst</span>
          <img src={p.image} alt="" width="120" height="120" class="mt-4 h-20 w-20 object-contain opacity-30 blur-[3px] grayscale sm:h-28 sm:w-28" />
          <p class="mt-3 text-xs font-medium text-paper sm:text-sm">{p.category}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <Eyebrow label="Häufig gestellte Fragen" />
    <h2 class="mt-4 max-w-2xl font-display text-2xl font-medium text-paper sm:text-3xl">
      Vor der Wahl
    </h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
    <a
      href="/de/faq/"
      class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist transition-colors hover:text-accent"
    >
      Vollständige FAQ ansehen <span aria-hidden="true">→</span>
    </a>
  </section>

  <CTASection
    title="Wissen Sie schon genau, was Sie brauchen?"
    description="Sagen Sie uns, was Sie sichern möchten — wir helfen Ihnen, das passende Produkt zu finden."
    buttonLabel="Kontakt aufnehmen"
    href="/de/contact/"
  />
</BaseLayout>
