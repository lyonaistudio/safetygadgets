---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import CTASection from "../../../components/CTASection.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import FAQAccordion from "../../../components/FAQAccordion.astro";
import { PRODUCTS_DE } from "../../../data/products.de";
import { formatPriceTTC } from "../../../data/products";
import { faqSchema } from "../../../lib/schema";
import { PAGE_SWITCHERS } from "../../../lib/i18n";

const faqItems = [
  {
    question: "Welches Produkt sollte ich wählen?",
    answer: "Für ein Fahrzeug: GF07 oder OBD. Für eine Tasche oder Schlüssel: der Bluetooth-Anhänger. Um Überwachung zu erkennen: der Detektor. Für einen Notfallalarm: der SOS-Alarm.",
  },
  {
    question: "Sind die angezeigten Preise inklusive MwSt.?",
    answer: "Ja, alle angezeigten Preise verstehen sich inklusive Mehrwertsteuer, ohne versteckte Kosten an der Kasse.",
  },
  {
    question: "Liefern Sie auch außerhalb Frankreichs?",
    answer: "Kontaktieren Sie uns mit Ihrer Lieferadresse, um Verfügbarkeit und Lieferzeiten zu prüfen.",
  },
];
const schema = faqSchema(faqItems);
---

<BaseLayout
  title="Unsere Produkte — Safety Gadgets"
  description="Entdecken Sie das Safety-Gadgets-Sortiment: GPS-Tracker, Bluetooth-Tracker und kompakte Spionage-Detektoren, getestet für den Alltag."
  path="/de/traceurs-gps/"
  lang="de"
  switcherLinks={PAGE_SWITCHERS.products}
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "Unsere Produkte", url: "/de/traceurs-gps/" }]} homeLabel="Startseite" homeUrl="/de/" />
  <PageHero
    eyebrow="SHOP"
    title="Unsere Produkte"
    description="Eine sorgfältig ausgewählte Reihe von Trackern und kompakten Detektoren, getestet für zuverlässigen Alltagseinsatz."
  />

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-3">
      {PRODUCTS_DE.map((product) => (
        <div class="reveal group card-lift relative flex flex-col border border-ink-line bg-ink p-4 transition-colors duration-200 hover:border-accent/60 sm:p-6">
          {product.badge && (
            <span class="mb-2 inline-block w-fit border border-accent bg-ink px-2 py-1 text-[10px] uppercase tracking-[0.1em] text-accent">
              {product.badge}
            </span>
          )}
          <a href={`/de/traceurs-gps/${product.slug}/`} class="flex flex-1 flex-col">
            <div class="product-stage h-32 border border-ink-line bg-ink-soft p-4 sm:h-40">
              <img
                src={product.image}
                alt={product.name}
                width="200"
                height="200"
                class="premium-photo mx-auto h-full w-full object-contain"
              />
            </div>
            <h2 class="mt-3 font-display text-base text-paper group-hover:text-accent sm:mt-6 sm:text-xl">
              {product.name}
            </h2>
            <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-paper-dim sm:mt-2 sm:text-sm">{product.shortDescription}</p>
          </a>
          <p class="mt-2 flex flex-wrap items-baseline gap-2 font-mono text-base text-accent sm:mt-4 sm:text-lg">
            {formatPriceTTC(product.price, product.currency)}
            {product.originalPrice && (
              <span class="text-xs text-mist line-through sm:text-sm">{formatPriceTTC(product.originalPrice, product.currency)}</span>
            )}
          </p>
          <a
            href={`/de/traceurs-gps/${product.slug}/`}
            class="mt-3 border border-accent px-3 py-1.5 text-center text-[10px] uppercase tracking-[0.1em] text-accent transition-colors hover:bg-accent hover:text-ink sm:mt-4 sm:px-4 sm:py-2 sm:text-xs sm:tracking-[0.15em]"
          >
            Produkt ansehen
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <Eyebrow label="Häufig gestellte Fragen" />
    <h2 class="mt-4 max-w-2xl font-display text-2xl font-medium text-paper sm:text-3xl">
      Vor der Wahl
    </h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
    <a
      href="/de/faq/"
      class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist transition-colors hover:text-accent"
    >
      Vollständige FAQ ansehen <span aria-hidden="true">→</span>
    </a>
  </section>

  <CTASection
    title="Wissen Sie schon genau, was Sie brauchen?"
    description="Sagen Sie uns, was Sie sichern möchten — wir helfen Ihnen, das passende Produkt zu finden."
    buttonLabel="Kontakt aufnehmen"
    href="/de/contact/"
  />
</BaseLayout>
