---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import PaymentBadges from "../components/PaymentBadges.astro";
---

<BaseLayout
  title="Panier — Safety Gadgets"
  description="Vérifiez votre sélection de trackers et détecteurs, puis payez directement en ligne par carte."
  path="/panier/"
>
  <Breadcrumb items={[{ name: "Panier", url: "/panier/" }]} />
  <PageHero
    eyebrow="Panier"
    title="Votre panier"
    description="Ajustez les quantités, puis réglez directement en ligne par carte — paiement sécurisé, expédition sous 24 à 48h."
  />

  <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-20">
    <div class="grid gap-6 sm:gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <div id="cart-empty" class="hidden rounded-2xl bg-ink-soft p-5 text-center sm:p-8">
          <p class="text-paper-dim">Votre panier est vide.</p>
          <a
            href="/traceurs-gps/"
            class="mt-4 inline-block rounded-lg bg-night px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-night-soft"
          >
            Voir nos produits
          </a>
        </div>
        <div id="cart-lines" class="hidden divide-y divide-ink-line rounded-2xl border border-ink-line px-5"></div>

        <div id="cart-suggestions-section" class="mt-8 hidden">
          <p class="text-[11px] font-medium uppercase tracking-[0.3em] text-accent">Complétez votre protection</p>
          <div id="cart-suggestions" class="mt-3 grid gap-4"></div>
        </div>
      </div>

      <aside class="space-y-4 sm:space-y-6">
        <div id="cart-summary" class="rounded-2xl bg-ink-soft p-6">
          <p class="text-xs uppercase tracking-[0.1em] text-mist">Sous-total</p>
          <p class="mt-2 font-mono text-2xl text-paper">0,00 € TTC</p>
        </div>
        <div id="cart-promo" class="hidden rounded-2xl border border-ink-line p-5">
          <form data-promo-form class="flex gap-2">
            <label for="promo-code" class="sr-only">Code promo</label>
            <input id="promo-code" name="code" autocomplete="off" placeholder="Code promo" class="min-w-0 flex-1 rounded-lg border border-ink-line bg-white px-3 py-2.5 text-sm uppercase text-paper outline-none placeholder:normal-case focus:border-accent" />
            <button type="submit" class="shrink-0 rounded-lg bg-gold px-4 py-2.5 text-sm font-semibold text-night transition-colors hover:bg-gold-soft disabled:opacity-50">Appliquer</button>
          </form>
          <div data-promo-applied hidden class="flex items-center justify-between gap-3 text-sm">
            <span class="text-paper">Code <strong data-promo-label class="font-mono"></strong> appliqué</span>
            <button type="button" data-promo-remove class="text-xs text-paper-dim underline hover:text-promo">Retirer</button>
          </div>
          <p data-promo-message hidden></p>
        </div>
        <button
          id="cart-checkout"
          type="button"
          class="block w-full rounded-lg bg-night px-6 py-3.5 text-center text-sm font-semibold text-white transition-colors hover:bg-night-soft disabled:pointer-events-none disabled:opacity-40"
        >
          Passer au paiement sécurisé
        </button>
        <p id="cart-checkout-error" class="hidden text-xs leading-relaxed text-promo" role="alert"></p>
        <a
          href="/contact/"
          class="block rounded-lg border border-ink-line px-6 py-3 text-center text-sm text-paper-dim transition-colors hover:border-accent hover:text-accent"
        >
          Une question avant d'acheter ?
        </a>
        <PaymentBadges />
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { initCartPage } from "../scripts/cart-page";
  document.addEventListener("astro:page-load", initCartPage);
</script>
