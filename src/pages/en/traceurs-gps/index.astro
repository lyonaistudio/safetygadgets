---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import PageHero from "../../../components/PageHero.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import CTASection from "../../../components/CTASection.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import FAQAccordion from "../../../components/FAQAccordion.astro";
import { PRODUCTS_EN } from "../../../data/products.en";
import { formatPriceTTC } from "../../../data/products";
import { faqSchema } from "../../../lib/schema";
import { PAGE_SWITCHERS } from "../../../lib/i18n";

const faqItems = [
  {
    question: "Which product should I choose?",
    answer: "For a vehicle: GF07 or OBD. For a bag or keys: the Bluetooth tag. To spot surveillance: the detector. For an emergency alert: the SOS alarm.",
  },
  {
    question: "Are the displayed prices tax included?",
    answer: "Yes, all displayed prices are tax included, with no hidden fees at checkout.",
  },
  {
    question: "Do you ship outside France?",
    answer: "Contact us with your delivery address to check availability and timelines.",
  },
];
const schema = faqSchema(faqItems);
---

<BaseLayout
  title="Our products — Safety Gadgets"
  description="Discover the Safety Gadgets range: GPS trackers, Bluetooth trackers and compact anti-spy detectors, tested for everyday use."
  path="/en/traceurs-gps/"
  lang="en"
  switcherLinks={PAGE_SWITCHERS.products}
  jsonLd={[schema]}
>
  <Breadcrumb items={[{ name: "Our products", url: "/en/traceurs-gps/" }]} homeLabel="Home" homeUrl="/en/" />
  <PageHero
    eyebrow="SHOP"
    title="Our products"
    description="A tightly curated selection of trackers and compact detectors, tested for everyday reliability."
  />

  <section class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 sm:pt-10">
    <div class="grid gap-5 sm:grid-cols-2">
      {PRODUCTS_EN.filter((p) => !p.comingSoon).map((product) => <ProductCard product={product} lang="en" />)}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 sm:pt-14">
    <p class="hidden text-[11px] font-medium uppercase tracking-[0.3em] text-accent sm:block">Coming soon</p>
    <h2 class="font-display text-lg font-semibold text-paper sm:mt-2 sm:text-3xl">More protection is on its way.</h2>
    <div class="mt-3 grid grid-cols-3 gap-2 sm:mt-6 sm:gap-5">
      {PRODUCTS_EN.filter((p) => p.comingSoon).map((p) => (
        <a href={`/en/traceurs-gps/${p.slug}/`} class="relative flex flex-col items-center rounded-xl border border-ink-line bg-white p-2.5 text-center sm:rounded-2xl sm:p-4">
          <span class="absolute left-2 top-2 rounded bg-night px-1.5 py-0.5 text-[8px] font-semibold uppercase tracking-wide text-gold sm:left-3 sm:top-3 sm:px-2 sm:text-[9px]">Soon</span>
          <img src={p.image} alt="" width="120" height="120" class="mt-4 h-12 w-12 object-contain opacity-30 blur-[3px] grayscale sm:h-28 sm:w-28" />
          <p class="mt-2 text-[11px] font-medium leading-tight text-paper sm:mt-3 sm:text-sm">{p.category}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-10 sm:py-20">
    <Eyebrow label="Frequently asked questions" />
    <h2 class="mt-4 max-w-2xl font-display text-2xl font-medium text-paper sm:text-3xl">
      Before you choose
    </h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
    <a
      href="/en/faq/"
      class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-mist transition-colors hover:text-accent"
    >
      See the full FAQ <span aria-hidden="true">→</span>
    </a>
  </section>

  <CTASection
    title="Know exactly what you need?"
    description="Tell us what you're looking to secure, and we'll point you to the right product."
    buttonLabel="Contact us"
    href="/en/contact/"
  />
</BaseLayout>
